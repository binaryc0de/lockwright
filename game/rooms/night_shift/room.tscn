[node name="WorkOrder" type="Node3D" parent="Office"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -0.95, 1.45, 2.994)
script = ExtResource("4_7mnw5")
title = "Contractor work order"
text_md = "# Kestrel Logistics - contractor work order KL-WO-2026-0417\n\n**Site:** regional office, Unit 4 Harbour Road - sysadmin office\n\n**Window:** 22:30 - 02:00. **Task:** core switch migration, night 2 of 2; cutover at 23:30.\n\nSysadmin **M. Reyes is off site tonight**; his notes are on the office whiteboard.\n\n**Security:** Dale (night guard) - use the office intercom.\n\nBadge doors run on the maglock system. If the mains fail, the UPS keeps the door panels alive for about an hour.\n\nSign in at the door, then go straight in.\n\n_Handwritten:_ Laptop + creds on Mark's desk - good luck! - J."
