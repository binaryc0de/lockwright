; Engine configuration file.
; Godot 4.7.2 (ADR-0002). Client and dedicated server share this project.

config_version=5

[application]

run/flush_stdout_on_print=true

config/name="Lockwright"
config/description="Virtual escape rooms with pluggable room packs and real CTF challenges."
run/main_scene="res://core/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="interactable"
3d_physics/layer_3="players"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
